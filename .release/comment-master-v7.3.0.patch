+.linear-status { color: #8793a3; font-size: 10px; white-space: nowrap; border: 1px solid #e0e6ee; border-radius: 20px; padding: 4px 9px; font-weight: 500; }
+.linear-status[data-done='true'] { border-color: #cae2d5; color: #287153; background: #f0f8f3; }
+.linear-section-body { padding: 0 22px 22px 68px; }
