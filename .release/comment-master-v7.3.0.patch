+.linear-sidebar-footer button { padding: 4px 0; font-size: 11px; color: #718196; }
+.linear-sidebar-toggle { display: none; }
+.linear-content { min-width: 0; max-width: 1060px; padding: 34px 0 0; }
+.linear-heading { display: flex; align-items: flex-start; justify-content: space-between; gap: 24px; margin-bottom: 26px; }
+.linear-eyebrow { margin: 0 0 8px; color: #6c7c90; font-size: 10px; font-weight: 650; letter-spacing: .11em; }
+.linear-heading h2 { margin: 0 0 9px; color: #20314b; font-size: clamp(25px, 2.4vw, 33px); letter-spacing: -.8px; line-height: 1.15; font-weight: 650; }
+.linear-heading p:last-child { color: #607087; margin: 0; font-size: 14px; line-height: 1.6; }
+.linear-local { display: flex; align-items: center; gap: 6px; color: #5c7066; flex: 0 0 auto; margin-top: 4px; font-size: 11px; }
+.linear-local > span { width: 6px; height: 6px; background: #328562; border-radius: 50%; }
+.linear-document-bar { display: flex; justify-content: space-between; gap: 12px; align-items: center; margin-bottom: 18px; padding: 14px 17px; border: 1px solid #d3deeb; border-radius: 9px; background: #eef3f8; }
+.linear-document-bar[hidden] { display: none; }
