+.linear-section { border: 1px solid #dce3ec; border-radius: 10px; margin: 0 0 12px; background: #fff; overflow: clip; scroll-margin-top: 92px; }
+.linear-section > summary { display: flex; align-items: center; gap: 15px; list-style: none; padding: 20px 22px; cursor: pointer; position: relative; }
+.linear-section > summary::-webkit-details-marker { display: none; }
+.linear-section > summary::after { content: '⌄'; color: #8190a3; font-size: 19px; width: 14px; transition: transform .15s; }
+.linear-section[open] > summary::after { transform: rotate(180deg); }
+.linear-section > summary:hover { background: #fafbfd; }
+.linear-step { width: 31px; height: 31px; display: grid; place-items: center; flex: 0 0 auto; border-radius: 7px; color: #6b7e96; background: #f1f4f8; font-size: 11px; font-weight: 600; }
+.linear-section[open] .linear-step { background: #eaf0f8; color: #284e79; }
+.linear-section-copy { flex: 1; min-width: 0; }
