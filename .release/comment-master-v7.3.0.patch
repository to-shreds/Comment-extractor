+/* v7.3.0: one document, collapsible steps, two final download actions. */
+:root { --linear-blue: #284e79; --linear-ink: #20314b; --linear-muted: #607087; --linear-line: #dce3ec; --linear-green: #287153; }
+body { background: #f5f7fa; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Arial, sans-serif; }
+.app-header { background: #fff; color: #20314b; box-shadow: none; border-bottom: 1px solid #dce3ec; padding: 12px 26px; min-height: 70px; }
+.brand-mark { background: #284e79; color: #fff; border: 0; border-radius: 9px; width: 38px; height: 38px; font-size: 14px; }
+.brand-block h1 { font-size: 19px; letter-spacing: -.4px; }
+.brand-block p { color: #607087; }
+.app-header .btn-light { color: #334860; background: #fff; border-color: #dce3ec; }
+.app-header .privacy-pill { color: #40566d; background: #f0f5f9; font-weight: 500; }
+.app-header .file-pill { background: #edf2f8; color: #34445d; }
+.app-header .file-pill.dirty::after { color: #946016; }
+.global-nav { background: #fff; border-color: #dce3ec; box-shadow: 0 10px 25px #20314b20; }
+.global-nav button { color: #20314b; }
+.global-nav button:hover, .global-nav button[aria-current='page'] { color: #20314b; background: #eef3f9; }
+body[data-route='home'] .header-actions .file-pill, body[data-route='home'] .linear-back-button { display: none !important; }
+#home.linear-home { display: block; max-width: none; margin: 0; }
+#linear-legacy-home, #linear-legacy-home[hidden] { display: none !important; }
+body[data-route='home'] .app-shell { max-width: 1500px; padding: 0 30px 36px 20px; }
+.linear-layout { display: grid; grid-template-columns: 228px minmax(0, 1fr); gap: 38px; align-items: start; }
+.linear-sidebar { position: sticky; top: 70px; padding: 32px 16px 28px 4px; border-right: 1px solid #dce3ec; max-height: calc(100dvh - 70px); overflow-y: auto; scrollbar-width: thin; }
+.linear-nav-label { margin: 0 10px 13px; color: #718196; font-size: 10px; font-weight: 700; letter-spacing: .12em; }
+.linear-sidebar nav { display: grid; gap: 4px; }
+.linear-sidebar button { font: inherit; text-align: left; color: #44566d; border: 0; background: transparent; cursor: pointer; }
+.linear-sidebar nav button { display: flex; gap: 11px; align-items: flex-start; width: 100%; padding: 10px; border-radius: 7px; font-size: 13px; font-weight: 600; line-height: 1.3; }
+.linear-sidebar nav button:hover, .linear-sidebar nav button[aria-current='step'] { background: #eaf0f8; color: #234c78; }
+.linear-nav-index { flex: 0 0 19px; color: #8592a3; font-size: 12px; padding-top: 1px; }
+.linear-sidebar small { display: block; margin-top: 3px; color: #8090a1; font-size: 10px; font-weight: 400; letter-spacing: 0; }
+.linear-sidebar small[data-done='true'] { color: #287153; }
+.linear-other-tools { margin-top: 22px; padding: 0 10px; font-size: 12px; color: #45586d; }
